(_flow fab_demo "2022.2-SP4.2"
    (_comment "Generated by Fabric Compiler (version on 2022.2-SP4.2<build 132111>) at Wed Sep 30 11:21:28 2026")
    (_version "1.1.0")
    (_status "initial")
    (_project 
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos)
                    (_device PGL50G)
                    (_speedgrade -6)
                    (_package MBG324)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../rtl/shift_reg.v" + "shift_reg"
                    (_format verilog)
                    (_timespec "2026-09-30T10:18:45")
                )
            )
        )
        (_widget wgt_my_ips_src
        )
        (_widget wgt_import_logic_con_file
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_simulation
        )
    )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state (_integer 2))
            (_db_output
                (_file "compile/shift_reg_comp.adf"
                    (_format adif)
                    (_timespec "2026-09-30T11:21:06")
                )
            )
            (_output
                (_file "compile/shift_reg.cmr"
                    (_format verilog)
                    (_timespec "2026-09-30T11:21:06")
                )
                (_file "compile/cmr.db"
                    (_format text)
                    (_timespec "2026-09-30T11:21:06")
                )
            )
        )
        (_widget wgt_rtl_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state (_integer 2))
            (_option selected_syn_tool_opt (_integer 2))
            (_db_output
                (_file "synthesize/shift_reg_syn.adf"
                    (_format adif)
                    (_timespec "2026-09-30T11:21:28")
                )
            )
            (_output
                (_file "synthesize/shift_reg_syn.vm"
                    (_format structural_verilog)
                    (_timespec "2026-09-30T11:21:28")
                )
                (_file "synthesize/shift_reg_controlsets.txt"
                    (_format text)
                    (_timespec "2026-09-30T11:21:28")
                )
                (_file "synthesize/snr.db"
                    (_format text)
                    (_timespec "2026-09-30T11:21:28")
                )
                (_file "synthesize/shift_reg.snr"
                    (_format text)
                    (_timespec "2026-09-30T11:21:28")
                )
            )
        )
        (_widget wgt_tech_view
            (_attribute _click_to_run (_switch ON))
